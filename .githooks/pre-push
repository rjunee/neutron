#!/usr/bin/env bash
#
# .githooks/pre-push — run the leak gate's Tier-1 PII rules over the commit
# messages you are about to publish, BEFORE they leave the machine.
#
# WHY THIS EXISTS. A public push is mirrored to GHArchive/BigQuery within the
# hour. File contents can be force-pushed away and are blocked by CI before a
# merge; a commit message or PR body cannot be taken back by anyone, including
# GitHub support. The Tier-1 PII denylist that catches owner proper nouns is a
# repository SECRET, so until now it could only ever run in CI — i.e. the first
# signal an author got about the one unredactable class of leak arrived AFTER
# the content was already public. On 2026-07-30 that is exactly what happened:
# CI caught owner names in a commit message and PR body, the branch was scrubbed
# and force-pushed, and the original push was already mirrored. Being careful is
# not a control. This is.
#
# WHAT IT RUNS. `scripts/ci/leak-gate.sh --messages-only` — the SAME script, the
# same denylist compiler and the same rules CI runs, reading the denylist from a
# local file outside the repo (see the gate's header, "LOCAL DENYLIST"). It is
# not a reimplementation, so it cannot drift out of agreement with CI.
#
# WHAT IT DOES NOT COVER. A PR title/body typed into `gh pr create` never passes
# through git, so no git hook can see it. Check one before you publish it:
#
#     LEAK_GATE_PR_BODY="$(cat pr-body.md)" \
#       bash scripts/ci/leak-gate.sh --messages-only
#
# FAIL-CLOSED. If the denylist cannot be loaded the gate exits 3 (INCOMPLETE)
# and this hook BLOCKS. "I could not check" must never be worth less than a
# failed check — treating it as a pass is the precise defect that let Tier-1 sit
# dead for ~3,700 CI runs. Install the denylist (scripts/install-git-hooks.sh
# tells you where) rather than working around this.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
GATE="$ROOT/scripts/ci/leak-gate.sh"

# A branch that predates the gate (bisect, an old worktree) has no script. Do not
# invent a failure the author cannot act on.
[ -x "$GATE" ] || [ -f "$GATE" ] || exit 0

ZERO='0000000000000000000000000000000000000000'
STATUS=0
CHECKED=0

# git feeds one line per ref being pushed: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # A deletion pushes no commits and no messages.
  [ "$local_sha" = "$ZERO" ] && continue
  CHECKED=1
  echo "leak-gate pre-push: ${local_ref:-?} → ${remote_ref:-?}"
  # remote_sha is all-zero for a branch the remote has never seen; the gate
  # already treats that as "no base" and falls back to origin/main, so it is
  # passed through verbatim rather than second-guessed here.
  #
  # AFTER A REBASE, remote_sha is NOT an ancestor of local_sha — the old tip was
  # discarded. `remote_sha..local_sha` then means "everything reachable from the
  # new commits but not the abandoned tip", which sweeps in all of main's history
  # and every commit message on it. GitHub stamps its squash merges with a
  # `Co-authored-by: <owner>` trailer, so that history legitimately contains the
  # owner's address — and the gate then fails a push over ALREADY-PUBLIC commits
  # the author cannot change. Observed 2026-07-31: it blocked every rebased push
  # to this repo, and three separate agents independently hit it.
  #
  # A gate that cannot be satisfied is one people learn to bypass with
  # --no-verify, which is strictly worse than no gate (ISSUES #432, #384). So
  # when remote_sha is not an ancestor, fall back to the MERGE-BASE, which is the
  # honest "what is genuinely new on this branch" boundary.
  base="$remote_sha"
  if [ "$remote_sha" != "$ZERO" ] \
     && ! git -C "$ROOT" merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    # The fork point from MAINLINE, not from the abandoned tip. Merge-base with
    # the old tip looked right and is not: a branch rebased onto a newer main
    # forks from the old main, so that range still contains every commit merged
    # to main in between — exactly the GitHub-stamped squashes this is trying to
    # exclude. Verified 2026-07-31: the merge-base form still failed the push.
    mb=$(git -C "$ROOT" merge-base "$local_sha" origin/main 2>/dev/null || true)
    if [ -z "$mb" ]; then
      # Unrelated histories (a recreated repo, an orphan branch): fall back to
      # origin/main rather than scanning from the dawn of time.
      mb=$(git -C "$ROOT" rev-parse origin/main 2>/dev/null || true)
    fi
    if [ -n "$mb" ]; then
      echo "leak-gate pre-push: rebase detected — scanning $(printf '%.12s' "$mb")..$(printf '%.12s' "$local_sha") (fork point from mainline), not the abandoned remote tip"
      base="$mb"
    fi
  fi
  LEAK_GATE_BASE_SHA="$base" \
  LEAK_GATE_HEAD_SHA="$local_sha" \
    bash "$GATE" --tree "$ROOT" --messages-only || STATUS=$?
  [ "$STATUS" -eq 0 ] || break
done

# No ref lines at all (git can invoke the hook with empty stdin) — nothing to
# check, and inventing a block here would only teach people to use --no-verify.
[ "$CHECKED" = "1" ] || exit 0

if [ "$STATUS" -ne 0 ]; then
  cat >&2 <<'EOF'

╭──────────────────────────────────────────────────────────────────────────────╮
│  PUSH BLOCKED — leak gate                                                    │
╰──────────────────────────────────────────────────────────────────────────────╯
A commit message you are about to publish either matched the PII denylist, or
could not be checked against it (see the verdict above — exit 3 means the rule
did not run, which is not a pass).

Commit messages are mirrored to GHArchive/BigQuery permanently and CANNOT be
redacted afterwards. Fix the message before it leaves the machine:

    git rebase -i --exec 'true' <base>      # reword the offending commit(s)
    git commit --amend                      # if it is just the tip

Then push again. If the finding is a false positive, the fix is the reviewable
allowlist in scripts/ci/leak-gate-allowlist.txt — not skipping the hook.
EOF
  exit 1
fi

# ── trident-verdict advisory — WARNS, NEVER BLOCKS ────────────────────────────
#
# A push is fine. Only the MERGE is gated: `trident-verdict` in ci.yml fails a PR
# whose head commit carries no review verdict. Saying so here, at push time,
# turns "your PR is red for a reason you have to go read" into "here is the one
# command that fixes it", roughly ten minutes earlier.
#
# It must never block, for the reason the leak-gate comment above already
# records: a gate that cannot be satisfied at the moment it fires is one people
# learn to bypass with --no-verify, which is strictly worse than no gate. There
# is nothing to satisfy at push time — a verdict is posted against a pushed SHA,
# so it cannot exist before the push. Hence: advisory only, and every command
# below is `|| true`.
#
# The command text is fetched FROM THE GATE (`--redeem-command`) rather than
# copied. A second spelling would drift from the one CI prints, and a drifted
# redemption path is a gate that only rejects.
{
  _tv_branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  _tv_gate="$ROOT/scripts/ci/trident-verdict.ts"
  _tv_cmd=""
  if [ -f "$_tv_gate" ] && command -v bun >/dev/null 2>&1; then
    _tv_cmd="$(bun "$_tv_gate" --redeem-command --branch "${_tv_branch:-}" 2>/dev/null || true)"
  fi
  if [ -n "$_tv_cmd" ]; then
    echo "" >&2
    echo "note: pushed. The MERGE is gated on a review verdict for this head commit." >&2
    echo "      If this branch has not been through a review lane, put it through one —" >&2
    echo "      it re-enters the existing branch and reuses the PR, nothing is rebuilt:" >&2
    echo "" >&2
    echo "        $_tv_cmd" >&2
    echo "" >&2
    echo "      docs/trident-verdict-gate.md" >&2
  fi
} || true

exit 0
