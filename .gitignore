.worktrees/
# trident's own scratch checkouts (rebase replay, purity preflight). A linked
# worktree's `.git` is a POINTER FILE holding an absolute path on this host, so
# these must never be stageable from the checkout they are created under.
.trident-worktrees/
STATUS.md

# Belt-and-braces. The leak gate's PII denylist is supposed to live OUTSIDE every
# working tree (see CONTRIBUTING.md) precisely so no `git add` can reach it. If a
# copy ever lands in here anyway, it must not be committable: the list names the
# exact strings it exists to keep out of a public repo.
leak-gate-pii-denylist*

# Scratch copy of main's route-slot inventory, written INSIDE the tree by
# scripts/ci/route-slot-ratchet-guard.sh so bun can import it, and removed on
# exit. Ignored so a killed run can never leave a committable stray.
.route-slot-inventory-main.*.ts

# Runtime state for a locally-running instance (REPL registry, heartbeat,
# restart markers). Machine-local: a committed repl-registry.json carries this
# install's absolute data path, which the leak gate correctly refuses.
.neutron/

# Scratch COPY of `trident/git-mode.ts` + its suite, written inside the tree by
# `trident/git-mode-mutation.test.ts` so bun resolves the workspace packages, and
# removed on exit. Ignored so a killed run can never leave a committable stray.
.trident-mutants/
